# Diwali date (ISO). After it passes, "The Festival of Lights Is Here!" shows.
VITE_DIWALI_DATE=2026-11-08T00:00:00+05:30
# Your deployed URL used in share links (optional; current address is used if empty).
VITE_SITE_URL=
# SHA-256 hash of YOUR private key. Only you can unlock the share panel. See guide.
VITE_OWNER_HASH=
# Optional: custom music URL. Default is /music/diwali.mp3 (put your file in public/music/).
VITE_MUSIC_URL=
